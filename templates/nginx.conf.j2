{% set NGX_MODULES_LOADED_LIST =  NGX_MODULES_LOADED.split(',') %}

load_module /usr/lib/nginx/modules/ngx_http_acme_module.so;

{% if 'ngx_http_geoip2' in NGX_MODULES_LOADED_LIST %}
{% set NGX_LOG_FORMAT = '\'$remote_addr - $remote_user [$time_local] "$request" \'
                        \'$status $body_bytes_sent "$http_referer" \'
                        \'"$http_user_agent" "$http_x_forwarded_for" \'
                        \'"$geoip2_data_country_code"\'' %}
{% else %}
{% set NGX_LOG_FORMAT = '\'$remote_addr - $remote_user [$time_local] "$request" \'
                        \'$status $body_bytes_sent "$http_referer" \'
                        \'"$http_user_agent" "$http_x_forwarded_for"\'' %}
{% endif %}


{% for item in NGX_MODULES_LOADED_LIST %}
load_module /usr/lib/nginx/modules/{{ item }}_module.so;
{% endfor %}

{% if 'ngx_http_lua' in NGX_MODULES_LOADED_LIST %}
include /etc/nginx/env.conf;
{% endif %}

user  nginx;
worker_processes  auto;
worker_rlimit_nofile 65535;

error_log  /var/log/nginx/error.log notice;
pid        /var/run/nginx.pid;

events {
    worker_connections  65535;
    use epoll;
    multi_accept on;
}

stream {
    include /etc/nginx/stream.d/*.conf;
}

http {
{% if 'ngx_http_vhost_traffic_status' in NGX_MODULES_LOADED_LIST %}
    vhost_traffic_status_zone;
{% endif %}

    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    log_format  main    {{ NGX_LOG_FORMAT }};

    access_log  /var/log/nginx/access.log main buffer=256k flush=5s;

    sendfile    on;
    tcp_nopush  on;
    tcp_nodelay on;

    keepalive_timeout  65;
    proxy_connect_timeout       600;
    proxy_send_timeout          600;
    proxy_read_timeout          600;
    send_timeout                600;
    reset_timedout_connection on;

    server_tokens off;
    client_max_body_size 50M;

    server_names_hash_bucket_size 128;
    types_hash_max_size    2048;
    types_hash_bucket_size 64;

    resolver 1.1.1.1 8.8.8.8 valid=300s ipv6=off;
    resolver_timeout 5s;

    acme_issuer letsencrypt {
        uri         {{ ACME_DIRECTORY_URI }};
        contact     {{ ACME_EMAIL }};
        state_path  /var/cache/nginx/acme-letsencrypt;
        accept_terms_of_service;
    }

    acme_shared_zone zone=ngx_acme_shared:1M;

{% if 'ngx_http_geoip2' in NGX_MODULES_LOADED_LIST %}
    geoip2 /usr/share/GeoLite2-Country.mmdb {
        auto_reload 60m;
        $geoip2_metadata_country_build metadata build_epoch;
        $geoip2_data_country_code country iso_code;
        $geoip2_data_country_name country names en;
        $geoip2_data_continent_code continent code;
    }
    geoip2 /usr/share/GeoLite2-City.mmdb {
        auto_reload 60m;
        $geoip2_metadata_city_build metadata build_epoch;
        $geoip2_data_country_name country names en;
        $geoip2_data_country_code country iso_code;
        $geoip2_data_city_name city names en;
        $geoip2_data_region_name subdivisions 0 names en;
        $geoip2_data_state_code  subdivisions 0 iso_code;
    }
{% endif %}
{% if NGX_LEVYUE_SITES_REJECTED is sameas true or NGX_LEVYUE_SITES_REJECTED == "true" %}
    server {
        listen 443 ssl default_server reuseport;
{% if NGX_IPV6_ENABLED is sameas true or NGX_IPV6_ENABLED == "true" %}
        listen [::]:443 ssl default_server reuseport;
{% endif %}
        http2 on;
        ssl_reject_handshake on;
        include ssl_params;
    }
{% endif %}

    include /etc/nginx/user_conf.d/*.conf;
    include /etc/nginx/conf.d/*.conf;
}
